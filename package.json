{
  "name": "@mdx-js/eslint",
  "version": "0.0.0",
  "type": "module",
  "description": "ESLint Parser/Plugin for MDX",
  "repository": "https://github.com/mdx-js/eslint-mdx.git",
  "author": "JounQin <admin@1stg.me> (https://www.1stG.me)",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "build": "concurrently -r 'yarn:build:*'",
    "build:r": "r -f cjs --esbuild '{target:es2022}'",
    "build:ts": "tsc -b",
    "clean": "rimraf --glob 'packages/*/{lib,*.tsbuildinfo}'",
    "format": "prettier --write .",
    "lint": "concurrently -r 'yarn:lint:*'",
    "lint:es": "eslint . --cache",
    "lint:tsc": "tsc --noEmit",
    "prepare": "patch-package && simple-git-hooks && yarn-berry-deduplicate --no-clusters || exit 0",
    "release": "run-s build release:only",
    "release:only": "changeset publish",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "typecov": "type-coverage",
    "version": "changeset version && yarn --no-immutable"
  },
  "devDependencies": {
    "@1stg/common-config": "^16.0.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@oxc-node/core": "^0.1.7",
    "@pkgr/rollup": "^7.1.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/unist": "^3.0.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@unts/patch-package": "^8.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "nano-staged": "^1.0.2",
    "path-serializer": "^0.7.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "remark-math": "^6.0.0",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.14.0",
    "ts-node": "^10.9.2",
    "type-coverage": "^2.30.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "yarn-berry-deduplicate": "^7.1.0"
  },
  "resolutions": {
    "eslint-mdx": "link:packages/eslint-mdx",
    "eslint-plugin-mdx": "link:packages/eslint-plugin-mdx",
    "prettier": "^3.8.3"
  },
  "commitlint": {
    "extends": [
      "@1stg"
    ]
  },
  "jest": {
    "extensionsToTreatAsEsm": [
      ".ts",
      ".tsx"
    ],
    "snapshotSerializers": [
      "<rootDir>/test/jest.serializer.cjs"
    ],
    "transform": {
      "^.+\\.[cm]?tsx?$": "@swc/jest"
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^eslint-mdx$": "<rootDir>/packages/eslint-mdx/src/index.ts",
      "^eslint-plugin-mdx$": "<rootDir>/packages/eslint-plugin-mdx/src/index.ts"
    },
    "collectCoverage": true,
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "prettier": "@1stg/prettier-config",
  "remarkConfig": {
    "plugins": [
      "@1stg/preset",
      "remark-math"
    ]
  },
  "typeCoverage": {
    "atLeast": 100,
    "cache": true,
    "detail": true,
    "ignoreAsAssertion": true,
    "ignoreCatch": true,
    "ignoreFiles": [
      "**/*.d.ts"
    ],
    "strict": true,
    "update": true
  }
}
